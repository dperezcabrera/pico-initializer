FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl git jq ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN git config --global user.email "test@test.com" \
 && git config --global user.name "test"

WORKDIR /opt/pico-initializer
COPY js/ js/
COPY cli.js .

# Pre-install all pico dependencies (constraints mirror js/versions.js)
RUN pip install --no-cache-dir \
    "pico-ioc[yaml]>=2.4.0,<3.0" \
    "pico-boot~=0.1.2" \
    "pico-fastapi~=0.3.0" \
    "pico-sqlalchemy~=0.4.0" \
    "pico-celery~=0.2.2" \
    "pico-pydantic~=0.2.2" \
    "pico-client-auth~=0.4.2" \
    "aiosqlite>=0.20.0" \
    "uvicorn" \
    "httpx" \
    "pytest" \
    "setuptools>=69.0" \
    "setuptools-scm>=8.0" \
    "wheel"

COPY test/integration.sh /opt/integration.sh
RUN chmod +x /opt/integration.sh

ENTRYPOINT ["/opt/integration.sh"]
