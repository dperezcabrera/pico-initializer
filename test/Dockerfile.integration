FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl git jq ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN git config --global user.email "test@test.com" \
 && git config --global user.name "test"

WORKDIR /opt/pico-initializer
COPY js/ js/
COPY cli.js .

# Pre-install all pico dependencies. Constraints are GENERATED from
# js/versions.js (single source of truth) — hand-copied lists drift.
RUN node --input-type=module -e 'const { PICO_VERSIONS } = await import("file:///opt/pico-initializer/js/versions.js"); console.log(Object.entries(PICO_VERSIONS).map(([n, v]) => (n === "pico-ioc" ? n + "[yaml]" + v : n + v)).join("\n"));' > /tmp/pico-requirements.txt \
 && pip install --no-cache-dir \
    -r /tmp/pico-requirements.txt \
    "aiosqlite>=0.20.0" \
    "uvicorn" \
    "httpx" \
    "pytest" \
    "setuptools>=69.0" \
    "setuptools-scm>=8.0" \
    "wheel"

COPY test/integration.sh /opt/integration.sh
RUN chmod +x /opt/integration.sh

ENTRYPOINT ["/opt/integration.sh"]
